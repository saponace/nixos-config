// niri config (KDL): https://kdl.dev
// Keep this file host-agnostic and managed by Home Manager.

input {
  keyboard {
    xkb {
      layout "us,ru,ua"
      options "grp:alt_shift_toggle,caps:escape"
    }
    repeat-rate 40
    repeat-delay 250
  }

  touchpad {
    tap
    natural-scroll
  }

  mouse {
    accel-profile "flat"
  }
}

layout {
  gaps 5

  focus-ring {
    width 2
    active-color "#f5a97f" // catppuccin macchiato peach
  }
}

// Save screenshots in a predictable location.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
  Mod+Return { spawn "alacritty"; }
  Mod+D { spawn "fuzzel"; }
  Super+Alt+L { spawn "swaylock"; }

  Mod+Q repeat=false { close-window; }
  Mod+F { maximize-column; }
  Mod+G { fullscreen-window; }
  Mod+Shift+F { toggle-window-floating; }
  Mod+C { center-column; }

  Mod+H { focus-column-left; }
  Mod+L { focus-column-right; }
  Mod+K { focus-window-up; }
  Mod+J { focus-window-down; }

  Mod+Shift+H { move-column-left; }
  Mod+Shift+L { move-column-right; }
  Mod+Shift+K { move-window-up; }
  Mod+Shift+J { move-window-down; }

  XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%+"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%-"; }
  XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
  XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

  // Screenshots
  Mod+Ctrl+S { spawn-sh "grim -l 0 - | wl-copy"; }
  Mod+Shift+S { spawn-sh "grim -g \"$(slurp -w 0)\" - | wl-copy"; }
  Mod+Shift+E { spawn-sh "wl-paste | swappy -f -"; }
}

spawn-at-startup "mako"

// X11 apps support.
xwayland-satellite {
  path "xwayland-satellite"
}
